# QLex Backend Server URL (Pointed to Live Cloud Run Backend)
QLEX_BACKEND_URL=https://qlex-backend-ybnb435gbq-el.a.run.app

# Polling Interval (in seconds)
POLL_INTERVAL_SECONDS=3

# Secret API Key matching QLex backend
PRINT_AGENT_SECRET_KEY=qlex-print-agent-secret

# Comma-separated Printer Names to include in pool (Leave empty to use all system printers)
# Example: PRINTER_POOL=HP LaserJet Pro,Epson L3150,Canon iR2006
PRINTER_POOL=

# Target Shop / Terminal Name (e.g. "QLex Satellite Print Hub" or "QLex Central Print Hub")
SHOP_NAME=QLex Satellite Print Hub

# Mock Print Mode (Set to true to test without sending jobs to physical paper)
MOCK_PRINT=false
